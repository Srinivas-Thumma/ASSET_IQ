# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://localhost:27017/assetowl_dev

# JWT Authentication Secrets
JWT_SECRET=your_jwt_access_token_secret_key_here
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRE=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Bootstrap Global Super Admin Credentials
SUPERADMIN_EMAIL=superadmin@assetowl.dev
SUPERADMIN_PASSWORD=YourSuperAdminPasswordHere123!
